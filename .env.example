# Variables de entorno de Home Deko — SIN valores (nunca commitear valores reales).
# Copiá este archivo a .env.local y completalo. En Vercel se cargan en
# Settings → Environment Variables. Detalle de cada una en CLAUDE.md.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Solo servidor
SUPABASE_SECRET_KEY=

# --- Sitio ---
NEXT_PUBLIC_SITE_URL=

# --- Pedidos (solo servidor; generar una vez y no cambiarla nunca) ---
ORDER_LINK_SECRET=

# --- Medio de pago: getnet (por defecto) | mercadopago ---
PAYMENT_PROVIDER=

# --- Getnet Web Checkout (solo servidor) ---
GETNET_CLIENT_ID=
GETNET_CLIENT_SECRET=
# sandbox | production
GETNET_ENV=
# Usuario y contraseña del webhook (los mismos que se cargan en el portal de Getnet)
GETNET_WEBHOOK_USER=
GETNET_WEBHOOK_PASSWORD=

# --- Mercado Pago (solo servidor; apagado con PAYMENT_PROVIDER=getnet) ---
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
# Opcional, solo para probar en local con un túnel
MERCADOPAGO_NOTIFICATION_URL_BASE=

# --- Mails (opcionales) ---
RESEND_API_KEY=
EMAIL_FROM=
